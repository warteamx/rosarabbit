---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 | RosaRabbit" description="The requested RosaRabbit page could not be found.">
  <section class="card empty-state">
    <p class="eyebrow">🛰 Lost in the lab</p>
    <h1>Page not found</h1>
    <p>The link may have moved during the Astro migration. Start from the archive or browse by tags.</p>
    <div class="hero-actions">
      <a class="button button--primary" href="/archive/">Open archive</a>
      <a class="button button--ghost" href="/tags/">View tags</a>
    </div>
  </section>
</BaseLayout>
